{
  "watch_dirs": [],
  "scripts_dir": "~/scripts",
  "pipeline": [
    "mkv_original_audio_subtitle_tracks.sh",
    "convert_to_dv81_hdr10only.sh --overwrite",
    "convert_4k_to_1080p.sh"
  ],
  "dry_run": false,
  "dry_run_flags": {
    "mkv_original_audio_subtitle_tracks.sh": "--dry-run",
    "convert_to_dv81_hdr10only.sh": "--dry-run",
    "convert_4k_to_1080p.sh": "-n"
  },
  "web_host": "127.0.0.1",
  "web_port": 5678,
  "settle_seconds": 5,
  "log_level": "INFO",
  "max_history": 200,
  "env_passthrough": [
    "HOME",
    "PATH",
    "TMDB_API_TOKEN",
    "TMDB_TOKEN",
    "JELLYFIN_URL",
    "JELLYFIN_TOKEN"
  ],
  "web_root": "/"
}
